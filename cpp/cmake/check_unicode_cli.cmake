foreach(required SOURCE_ROOT OUTPUT_ROOT EXAMPLES PARITY BENCHMARK)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef token)
set(root "${OUTPUT_ROOT}/unicode_cli_${token}/中文 输出 Ω 😀")
set(reference "${root}/参考 输入 Ω 😀")
set(examples_out "${root}/示例 结果 Ω 😀")
set(benchmark_out "${root}/基准 结果 Ω 😀")
file(MAKE_DIRECTORY "${root}")
file(COPY "${SOURCE_ROOT}/cpp/tests/reference/" DESTINATION "${reference}")

function(run_cli label program)
  execute_process(COMMAND "${program}" ${ARGN}
    WORKING_DIRECTORY "${SOURCE_ROOT}" TIMEOUT 120
    RESULT_VARIABLE code OUTPUT_FILE "${root}/${label}.log"
    ERROR_FILE "${root}/${label}.stderr.log")
  if(NOT code STREQUAL "0")
    file(READ "${root}/${label}.stderr.log" error)
    message(FATAL_ERROR "${label} failed (${code}): ${error}")
  endif()
endfunction()

run_cli(examples "${EXAMPLES}" all "${examples_out}")
foreach(case vibration planar terminal_defect obstacle_2d obstacle_3d reactor pendulum thermal storage)
  foreach(name states.csv controls.csv time.csv metrics.json config.json)
    if(NOT EXISTS "${examples_out}/${case}/${name}")
      message(FATAL_ERROR "Missing Unicode example output: ${case}/${name}")
    endif()
  endforeach()
  file(READ "${examples_out}/${case}/metrics.json" metrics)
  string(JSON passed GET "${metrics}" success)
  if(NOT passed)
    message(FATAL_ERROR "Unicode example failed physical acceptance: ${case}")
  endif()
endforeach()
run_cli(parity "${PARITY}" "${reference}")
run_cli(benchmark "${BENCHMARK}" "${reference}" "${benchmark_out}")
file(STRINGS "${benchmark_out}/timings.csv" rows)
list(LENGTH rows row_count)
if(NOT row_count EQUAL 46)
  message(FATAL_ERROR "Expected header and 45 measured benchmark rows")
endif()
list(REMOVE_AT rows 0)
foreach(row IN LISTS rows)
  string(REPLACE "," ";" fields "${row}")
  list(GET fields 3 passed)
  if(NOT passed STREQUAL "1")
    message(FATAL_ERROR "Benchmark acceptance failed")
  endif()
endforeach()

# A second run must refuse to overwrite the same results.
file(SHA256 "${examples_out}/vibration/states.csv" before)
execute_process(COMMAND "${EXAMPLES}" all "${examples_out}"
  RESULT_VARIABLE overwrite_code OUTPUT_VARIABLE ignored ERROR_VARIABLE overwrite_error TIMEOUT 30)
if(overwrite_code STREQUAL "0" OR NOT overwrite_error MATCHES "Choose a new output directory")
  message(FATAL_ERROR "Existing Unicode output directory was not rejected correctly")
endif()
file(SHA256 "${examples_out}/vibration/states.csv" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Existing Unicode output was modified")
endif()
message(STATUS "Unicode CLI PASS: nine examples, nine parity cases, 45 timings, overwrite protection; ${root}")
