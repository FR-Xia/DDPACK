file(STRINGS "${ROOT}/cpp/tests/reference/MATLAB_SOURCE_SHA256.csv" entries)
list(POP_FRONT entries)
foreach(entry IN LISTS entries)
  string(REPLACE "\"" "" entry "${entry}")
  string(REPLACE "," ";" parts "${entry}")
  list(GET parts 0 relative)
  list(GET parts 1 expected)
  file(SHA256 "${ROOT}/${relative}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "MATLAB reference source changed: ${relative}; regenerate and review references")
  endif()
endforeach()
